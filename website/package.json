{
  "name": "find-my-doggo",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "design:check": "node scripts/check-design-system.mjs",
    "check:env": "node scripts/check-env.mjs",
    "smoke": "node scripts/smoke.mjs",
    "brand:generate": "node scripts/generate-brand.mjs",
    "seed": "node scripts/seed.mjs",
    "depcruise": "depcruise src tests",
    "check": "npm run lint && npm run design:check && npm run typecheck && npm run depcruise && npm test && npm run build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.8.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@total-typescript/shoehorn": "^0.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "lint-staged": "^17.6.2",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "zod": "$zod"
  },
  "simple-git-hooks": {
    "pre-commit": "cd website && npx lint-staged && npm run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "eslint --max-warnings=0"
  }
}
