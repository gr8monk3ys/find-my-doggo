# Every value here is optional: with none of them set, `npm run dev` works
# against a local SQLite file and stores uploads on disk.

# --- Database -----------------------------------------------------------
# libSQL connection string. Defaults to a local file if unset.
# Local:      file:./data/dev.db
# Production: libsql://<your-database>.turso.io
DATABASE_URL=file:./data/dev.db
# Required only for a hosted libSQL/Turso database.
DATABASE_AUTH_TOKEN=

# --- Photo uploads ------------------------------------------------------
# Without this, photos are written to data/uploads, which does not survive a
# serverless deploy. Set it in production.
BLOB_READ_WRITE_TOKEN=

# --- Enquiry delivery ---------------------------------------------------
# Without these, enquiries are stored but not emailed to the reporter.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# --- Geocoding ----------------------------------------------------------
# Nominatim asks for an identifying User-Agent with a contact address.
GEOCODER_USER_AGENT=
# Set to 1 to skip geocoding entirely (used by the test suite and offline dev).
DISABLE_GEOCODING=

# --- Site ---------------------------------------------------------------
# Canonical origin for metadata, robots.txt, and the sitemap. Inferred from
# Vercel's environment when deployed there.
NEXT_PUBLIC_SITE_URL=

# Point at a self-hosted Nominatim instead of the public instance.
GEOCODER_URL=
